<Window x:Class="SteamStopper.LeftoversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Leftover files" Width="760" Height="520" MinWidth="560" MinHeight="380"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
  <DockPanel Margin="24,0,24,20">
    <DockPanel DockPanel.Dock="Top" Height="56">
      <Button DockPanel.Dock="Right" Style="{StaticResource CaptionClose}" Height="40" VerticalAlignment="Top" Margin="0,0,-24,0"
              Click="Cancel_Click" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 2,2 L 10,10 M 10,2 L 2,10"/>
      </Button>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="HeadingText" Text="Leftover folders" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
        <TextBlock x:Name="SubText" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,1,0,0"/>
      </StackPanel>
    </DockPanel>

    <Border DockPanel.Dock="Top" Background="#2E2614" BorderBrush="#4A3B17" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,4,0,14">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Amber}" Margin="0,2,10,0"/>
        <TextBlock Foreground="{StaticResource Amber}" FontSize="12" TextWrapping="Wrap"
                   Text="These folders hold the app's settings, caches and sometimes your data (mail, saves, notes). Deleting them cannot be undone. Large folders start unticked."/>
      </DockPanel>
    </Border>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Keep all" Style="{StaticResource GhostButton}" Click="Cancel_Click"/>
        <Button x:Name="DeleteButton" Content="Delete selected" Style="{StaticResource DangerButton}" Margin="0" Click="Delete_Click"/>
      </StackPanel>
      <TextBlock x:Name="TotalText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
    </DockPanel>

    <Border Style="{StaticResource CardBorder}" Padding="12,10,8,6">
      <DataGrid x:Name="Grid">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="40">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="APP" Binding="{Binding App}" Width="130"/>
          <DataGridTemplateColumn Header="FOLDER" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="90"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</Window>
