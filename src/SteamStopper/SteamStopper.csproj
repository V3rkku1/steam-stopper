<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); its namespaces stay out of the global usings so WPF types aren't ambiguous. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SteamStopper</AssemblyName>
    <RootNamespace>SteamStopper</RootNamespace>
    <Product>Steam Multitool</Product>
    <ApplicationTitle>Steam Multitool</ApplicationTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Precompiled (ReadyToRun) so start-up doesn't wait for the JIT; needs a runtime, so it is set here. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <Version>2.5.4</Version>
    <FileVersion>2.5.4</FileVersion>
    <AssemblyVersion>2.5.4</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <Content Include="FeedUrl.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\apps\*.png" />
    <!-- Shown by WPF the moment the process starts, before the window is built; closes itself when it appears. -->
    <SplashScreen Include="Assets\splash.png" />
  </ItemGroup>
</Project>
