<Window x:Class="SteamStopper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Steam Multitool" Height="760" Width="1260" MinHeight="620" MinWidth="1100"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}"
        BorderBrush="{DynamicResource Line}" BorderThickness="1">
  <Grid>
  <DockPanel>
    <Border x:Name="SidebarPanel" DockPanel.Dock="Left" Width="212" Background="{DynamicResource Sidebar}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Height="56" Margin="18,0,12,0">
          <Image Source="Assets/app.ico" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Steam Multitool" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,1,0,0" Cursor="Hand"
                       ToolTip="Click to check for updates" MouseLeftButtonUp="VersionText_Click"/>
          </StackPanel>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
          <TextBlock x:Name="UpdateState" Visibility="Collapsed" Text="Not checked yet" Foreground="{DynamicResource Muted}" FontSize="11" Margin="2,0,0,6" TextWrapping="Wrap"/>
          <Button x:Name="UpdateCheckButton" Visibility="Collapsed" Content="Check for updates" Style="{StaticResource GhostButton}" Margin="0,0,0,14"
                  HorizontalAlignment="Stretch" Click="UpdateCheck_Click" ToolTip="Look for a new Steam Multitool and new emulator builds now"/>
          <TextBlock x:Name="SteamPathText" Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="11" Margin="2,0,0,14" TextTrimming="CharacterEllipsis"/>
          <DockPanel x:Name="AdminRow">
            <Ellipse x:Name="AdminDot" Width="8" Height="8" Fill="{DynamicResource Faint}" VerticalAlignment="Center" Margin="2,0,8,0"/>
            <TextBlock x:Name="AdminChip" Text="standard user" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/>
          </DockPanel>
          <Button x:Name="ElevateButton" Content="Relaunch as admin" Style="{StaticResource GhostButton}"
                  Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="Elevate_Click"/>
        </StackPanel>
        <!-- Scrolls only when the window is too short for the menu and the sidebar footer. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10,14,10,0">
          <TextBlock Text="MENU" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Faint}" Margin="12,0,0,8"
                     ToolTip="Drag a menu item to move it"/>
          <!-- Drag an item up or down to reorder; the order is saved. -->
          <StackPanel x:Name="NavList" AllowDrop="True" Background="Transparent">
          <!-- Six groups; a group with several pages shows them as tabs in the title bar. -->
          <RadioButton Style="{StaticResource NavItem}" Tag="home" Click="Nav_Click" IsChecked="True">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE80F;"/>
              <TextBlock Style="{StaticResource NavText}" Text="Home"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" Tag="steam" Click="Nav_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE7E8;"/>
              <TextBlock Style="{StaticResource NavText}" Text="Steam"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" Tag="games" Click="Nav_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE7FC;"/>
              <TextBlock Style="{StaticResource NavText}" Text="Games"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" Tag="fetch" Click="Nav_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE896;"/>
              <TextBlock Style="{StaticResource NavText}" Text="Fetch"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" Tag="net" Click="Nav_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE968;"/>
              <TextBlock Style="{StaticResource NavText}" Text="Network"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" Tag="tools" Click="Nav_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE90F;"/>
              <TextBlock Style="{StaticResource NavText}" Text="Tools"/>
            </StackPanel>
          </RadioButton>
          </StackPanel>
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid DockPanel.Dock="Top" Height="56">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="28,0,12,0">
        <TextBlock x:Name="PageTitle" Text="Control" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
        <TextBlock x:Name="PagePath" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <!-- The pages of the open group (Steam: Control, Downloads, Library…). -->
      <Border x:Name="SubTabBar" Background="{DynamicResource Raised}" CornerRadius="12" Padding="3" HorizontalAlignment="Right" VerticalAlignment="Center"
              Margin="0,0,16,0" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <StackPanel x:Name="SubTabs" Orientation="Horizontal"/>
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="SettingsButton" Style="{StaticResource CaptionButton}" Click="Settings_Click" ToolTip="Settings">
          <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
        </Button>
        <Button Style="{StaticResource CaptionButton}" Click="Min_Click" ToolTip="Minimize">
          <Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M 1,6 L 11,6"/>
        </Button>
        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="Max_Click" ToolTip="Maximize">
          <Grid Width="12" Height="12">
            <Path x:Name="MaxIcon" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.4" Fill="Transparent" Data="M 1.5,1.5 L 10.5,1.5 L 10.5,10.5 L 1.5,10.5 Z"/>
            <Path x:Name="RestoreIcon" Visibility="Collapsed"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.4" Fill="Transparent"
                  Data="M 4,1.5 L 10.5,1.5 L 10.5,8 M 1.5,4 L 8,4 L 8,10.5 L 1.5,10.5 Z"/>
          </Grid>
        </Button>
        <Button Style="{StaticResource CaptionClose}" Click="Close_Click" ToolTip="Close">
          <Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M 2,2 L 10,10 M 10,2 L 2,10"/>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Menu on top (Settings): the sidebar's menu moves here as a tab bar. -->
    <Border x:Name="TopNav" DockPanel.Dock="Top" Visibility="Collapsed" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,0,20,0">
      <ScrollViewer x:Name="TopNavHost" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"/>
    </Border>

    <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="28,0,28,12" CornerRadius="12" Padding="16,10"
            Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="UpdateNotesButton" Content="What's new" Style="{StaticResource LinkButton}" Margin="0,0,4,0" Click="UpdateNotes_Click"/>
          <Button x:Name="UpdateSkipButton" Content="Skip this version" Style="{StaticResource LinkButton}" Margin="0,0,4,0" Click="UpdateSkip_Click"/>
          <Button x:Name="UpdateLaterButton" Content="Later" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="UpdateLater_Click"/>
          <Button x:Name="UpdateNowButton" Content="Update now" Style="{StaticResource SmallPrimary}" Margin="0" Click="UpdateNow_Click"/>
        </StackPanel>
        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="16"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold"/>
          <TextBlock x:Name="UpdateDetail" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,9">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock x:Name="FirewallChip" Text="" FontSize="12" Foreground="{DynamicResource Muted}" Margin="16,0,0,0"/>
          <TextBlock x:Name="DnsChip" Text="" FontSize="12" Foreground="{DynamicResource Muted}" Margin="16,0,0,0"/>
          <TextBlock x:Name="BondChip" Text="" FontSize="12" Foreground="{DynamicResource Muted}" Margin="16,0,0,0"/>
          <TextBlock x:Name="DownloadChip" Text="" FontSize="12" Foreground="{DynamicResource Muted}" Margin="16,0,0,0"/>
          <TextBlock x:Name="AutoChip" Text="" FontSize="12" Foreground="{DynamicResource Muted}" Margin="16,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Text="Ready." Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <Grid Margin="28,6,28,20">
      <!-- ===================== CONTROL ===================== -->
      <!-- ===================== SETTINGS ===================== -->
      <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
              <TextBlock Text="Theme" FontWeight="SemiBold"/>
              <TextBlock x:Name="ThemeHint" Text="Steam uses the Steam client's navy and blue. Liquid Glass is iOS-style see-through glass (Windows 11). From my game takes its colour from the cover of the game you play most." Foreground="{DynamicResource Faint}" FontSize="12" Margin="0,2,0,10" TextWrapping="Wrap"/>
              <Border Background="{DynamicResource Raised}" CornerRadius="12" Padding="3" HorizontalAlignment="Left">
                <StackPanel x:Name="ThemeBar" Orientation="Horizontal"/>
              </Border>
              <TextBlock Text="Your own themes" FontWeight="SemiBold" Margin="0,16,0,0"/>
              <TextBlock Text="A theme is a small CSS file of colours (--bg, --accent, --radius, --backdrop…). New theme copies the current colours into one and opens it; the app updates every time you save."
                         Foreground="{DynamicResource Faint}" FontSize="12" Margin="0,2,0,10" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="CustomThemeBox" Width="220" Margin="0,0,8,0" SelectionChanged="CustomTheme_Changed"/>
                <Button Content="New theme" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="NewTheme_Click"/>
                <Button Content="Open themes folder" Style="{StaticResource SmallButton}" Click="ThemesFolder_Click"/>
              </StackPanel>
              <TextBlock Text="Menu" FontWeight="SemiBold" Margin="0,16,0,0"/>
              <TextBlock Text="On top puts the pages in a tab bar across the window, like Steam." Foreground="{DynamicResource Faint}" FontSize="12" Margin="0,2,0,10"/>
              <Border Background="{DynamicResource Raised}" CornerRadius="12" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="NavSideButton" Content="On the left" GroupName="NavPos" Style="{StaticResource Segment}" Click="NavPosition_Click"/>
                  <RadioButton x:Name="NavTopButton" Content="On top" GroupName="NavPos" Style="{StaticResource Segment}" Click="NavPosition_Click"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="RETROACHIEVEMENTS" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
              <TextBlock Foreground="{DynamicResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                         Text="Shows your achievements on each game's page. Earn them by logging in to RetroAchievements inside DuckStation, PCSX2, PPSSPP, Dolphin or RetroArch. Your Web API key is on retroachievements.org under Settings, and is stored encrypted on this PC."/>
              <UniformGrid Columns="2" Margin="0,0,0,10">
                <StackPanel Margin="0,0,6,0">
                  <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="RaUserBox"/>
                </StackPanel>
                <StackPanel Margin="6,0,0,0">
                  <TextBlock Text="Web API key" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="RaKeyBox"/>
                </StackPanel>
              </UniformGrid>
              <StackPanel Orientation="Horizontal">
                <Button Content="Save and check" Style="{StaticResource SmallPrimary}" Margin="0,0,8,0" Click="RaSave_Click"/>
                <Button Content="Get my key" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="RaKeyPage_Click"/>
                <Button Content="Disconnect" Style="{StaticResource SmallButton}" Click="RaClear_Click"/>
              </StackPanel>
              <TextBlock x:Name="RaStatus" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel>
                <ToggleButton x:Name="BoostBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Boost_Click"/>
                <StackPanel>
                  <TextBlock Text="GAME BOOST" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                  <TextBlock Text="Close these background apps when you press Play on the Games tab, and open them again when the game closes. One program name per line."
                             Foreground="{DynamicResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,0,12,10"/>
                </StackPanel>
              </DockPanel>
              <TextBox x:Name="BoostAppsBox" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto" LostFocus="BoostApps_Changed"/>
              <TextBlock x:Name="BoostRunning" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="Open backups folder" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="SavesOpen_Click"/>
                  <Button x:Name="SavesAllButton" Content="Back up all" Style="{StaticResource SmallPrimary}" Click="SavesAll_Click"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="SAVE BACKUPS" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                  <TextBlock Text="Zips your emulator and PC port saves into Documents\Steam Multitool Backups. The last 10 are kept."
                             Foreground="{DynamicResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0"/>
                </StackPanel>
              </DockPanel>
              <ItemsControl x:Name="SavesList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Content="Back up" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="SaveBackup_Click" IsEnabled="{Binding HasSaves}"/>
                          <Button Content="Restore…" Style="{StaticResource SmallButton}" Click="SaveRestore_Click" IsEnabled="{Binding HasBackups}"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folders}"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="SavesEmpty" Text="Install an emulator or PC port first; its saves show up here." Foreground="{DynamicResource Muted}" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="MENU" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reset order" Style="{StaticResource SmallButton}" VerticalAlignment="Center" Click="NavReset_Click"/>
                <StackPanel>
                  <TextBlock Text="Menu order" FontWeight="SemiBold"/>
                  <TextBlock Text="Drag any item in the menu to a new place to move it." Foreground="{DynamicResource Faint}" FontSize="12" Margin="0,2,12,0" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Text="Open on" FontWeight="SemiBold" Margin="0,16,0,6"/>
              <ComboBox x:Name="StartPageBox" Width="240" HorizontalAlignment="Left" SelectionChanged="StartPage_Changed"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="WINDOW" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
              <TextBlock Text="When I close the window" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <ComboBox x:Name="CloseActionBox" Width="240" HorizontalAlignment="Left" SelectionChanged="CloseAction_Changed"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="SettingsAbout" Foreground="{DynamicResource Faint}" FontSize="11" Margin="4,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>

      <!-- ===================== HOME ===================== -->
      <Grid x:Name="PageHome">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="14"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="14"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource HeroCard}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="HomeBlockButton" Visibility="Collapsed" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Padding="18,10" Click="HomeBlock_Click"/>
              <Button Content="Open Steam" Style="{StaticResource SafeButton}" Padding="18,10" Click="Launch_Click"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock x:Name="HomeGreeting" Text="Welcome back" Style="{StaticResource Hero}" FontSize="30"/>
              <TextBlock x:Name="HomeSummary" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Continue playing: the most recent games from the Games tab, like Steam's library shelf. -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="20,16,20,14">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" Content="All games" Style="{StaticResource SmallButton}" Click="HomeGames_Click"/>
              <TextBlock x:Name="HomeShelfTitle" Text="CONTINUE PLAYING" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <!-- Top margin: covers lift 5 px on hover and the scroller would clip them. -->
                <ItemsControl x:Name="HomeShelf" Margin="0,6,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Click="HomeGame_Click" Cursor="Hand" Margin="0,0,14,0" ToolTip="{Binding Title}">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <StackPanel Width="150">
                              <!-- Lifts a little under the mouse, like a card on iOS. -->
                              <Grid x:Name="Lift" Height="200">
                                <Grid.RenderTransform>
                                  <TranslateTransform/>
                                </Grid.RenderTransform>
                                <Border CornerRadius="8" Background="{Binding Color, Converter={StaticResource HexBrush}}">
                                  <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="30" FontWeight="Black"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border CornerRadius="8">
                                  <Border.Background>
                                    <ImageBrush ImageSource="{Binding Cover, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                  </Border.Background>
                                </Border>
                                <Border x:Name="Ring" CornerRadius="8" BorderBrush="{DynamicResource Accent}" BorderThickness="2" Opacity="0"/>
                              </Grid>
                              <TextBlock Text="{Binding Title}" Margin="2,8,2,0" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding ShelfText}" Margin="2,2,2,0" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-5" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                      </DoubleAnimation>
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                      </DoubleAnimation>
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel x:Name="HomeShelfEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Visibility="Collapsed">
                <TextBlock Text="Your games show up here" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Add the folder with your game files on the Games tab. The ones you play last come first."
                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,14"/>
                <Button Content="Add games" Style="{StaticResource SafeButton}" HorizontalAlignment="Center" Padding="22,9" Click="HomeGames_Click"/>
              </StackPanel>
            </Grid>
          </DockPanel>
        </Border>

        <UniformGrid Grid.Row="4" Columns="3">
          <Border Style="{StaticResource CardBorder}" Margin="0,0,7,0" Padding="18,14">
            <DockPanel>
              <Button DockPanel.Dock="Bottom" Content="Steam controls" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Tag="control" Click="HomeGo_Click"/>
              <StackPanel>
                <TextBlock Text="STEAM" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                <TextBlock x:Name="HomeSteam" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="HomeSteamHint" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}" Margin="7,0" Padding="18,14">
            <DockPanel>
              <Button DockPanel.Dock="Bottom" Content="Open Fetch" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Tag="fetch" Click="HomeGo_Click"/>
              <StackPanel>
                <TextBlock Text="DOWNLOADS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                <TextBlock x:Name="HomeFetch" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="HomeFetchHint" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="HomeFetchBar" Height="4" Maximum="1" Margin="0,10,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}" Margin="7,0,0,0" Padding="18,14">
            <DockPanel>
              <Button DockPanel.Dock="Bottom" Content="Check for updates" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="UpdateCheck_Click"/>
              <StackPanel>
                <TextBlock Text="UPDATES" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                <TextBlock x:Name="HomeUpdates" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="HomeUpdatesHint" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </UniformGrid>
      </Grid>

      <Grid x:Name="PageControl" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="14"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="14"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource HeroCard}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock Text="STEAM INTERNET ACCESS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
              <TextBlock x:Name="BlockHeadline" Text="Checking…" Style="{StaticResource Hero}" FontSize="34"/>
              <TextBlock x:Name="RuleCount" Text="Checking Steam’s firewall rules…" Foreground="{DynamicResource Muted}" Margin="0,4,0,16" TextWrapping="Wrap"/>
              <WrapPanel>
                <DockPanel Style="{StaticResource Option}">
                  <ToggleButton x:Name="KillAfterBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="Persist_Changed" Unchecked="Persist_Changed"/>
                  <TextBlock Text="Quit Steam when blocking" Style="{StaticResource OptionText}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Option}">
                  <ToggleButton x:Name="RestartAfterBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="Persist_Changed" Unchecked="Persist_Changed"/>
                  <TextBlock Text="Restart Steam when restoring" Style="{StaticResource OptionText}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Option}">
                  <ToggleButton x:Name="GameExeBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="Persist_Changed" Unchecked="Persist_Changed"/>
                  <TextBlock Text="Also block game executables" Style="{StaticResource OptionText}"/>
                </DockPanel>
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <ToggleButton x:Name="BlockSwitch" Style="{StaticResource SwitchHero}" Click="BlockSwitch_Click"
                            ToolTip="Turn off to block Steam with Windows Firewall"/>
              <TextBlock Text="Online  /  Blocked" Foreground="{DynamicResource Faint}" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="4" Visibility="Collapsed">
          <Border Style="{StaticResource StatTile}">
            <DockPanel>
              <Border Style="{StaticResource StatIcon}"><TextBlock Style="{StaticResource StatGlyph}" Text="&#xE7FC;"/></Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Steam client" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="TileClient" Text="—" Style="{StaticResource StatValue}"/>
                <TextBlock x:Name="ClientHint" Text="" Style="{StaticResource StatHint}"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource StatTile}">
            <DockPanel>
              <Border Style="{StaticResource StatIcon}"><TextBlock Style="{StaticResource StatGlyph}" Text="&#xE701;"/></Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Network" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="TileNetwork" Text="—" Style="{StaticResource StatValue}"/>
                <TextBlock Text="Windows Firewall" Style="{StaticResource StatHint}"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource StatTile}">
            <DockPanel>
              <Border Style="{StaticResource StatIcon}"><TextBlock Style="{StaticResource StatGlyph}" Text="&#xE8F1;"/></Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Library" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="TileLibrary" Text="—" Style="{StaticResource StatValue}"/>
                <TextBlock x:Name="TileLibraryHint" Text="" Style="{StaticResource StatHint}"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource StatTile}" Margin="0">
            <DockPanel>
              <Border Style="{StaticResource StatIcon}"><TextBlock Style="{StaticResource StatGlyph}" Text="&#xE896;"/></Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Downloads" Style="{StaticResource StatLabel}"/>
                <TextBlock x:Name="TileDownloads" Text="—" Style="{StaticResource StatValue}"/>
                <TextBlock Text="Steam queue" Style="{StaticResource StatHint}"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.6*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource CardBorder}" Padding="20,18,12,10">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,8,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="Offline mode" Style="{StaticResource LinkButton}" Click="LaunchOffline_Click" ToolTip="Start Steam with -offline"/>
                  <Button Content="Quit" Style="{StaticResource SmallButton}" Click="Kill_Click"/>
                  <Button Content="Open Steam" Style="{StaticResource SmallPrimary}" Margin="0" Click="Launch_Click"/>
                </StackPanel>
                <TextBlock Text="STEAM PROCESSES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
              </DockPanel>
              <DataGrid x:Name="ProcGrid">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="PROCESS" Binding="{Binding Name}" Width="*"/>
                  <DataGridTextColumn Header="MEMORY" Binding="{Binding Memory}" Width="100"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="AFTER DOWNLOADS" Style="{StaticResource SectionLabel}"/>
              <StackPanel DockPanel.Dock="Bottom">
                <Button Content="Set up auto shutdown" Style="{StaticResource WideSafe}" Click="OpenDownloads_Click"/>
                <UniformGrid Columns="2" Margin="0,8,0,0">
                  <Button Content="Sleep now" Style="{StaticResource WideButton}" Margin="0,0,4,0" Click="Power_Click" Tag="sleep"/>
                  <Button Content="Shut down now" Style="{StaticResource WideButton}" Margin="4,0,0,0" Click="Power_Click" Tag="shutdown"/>
                </UniformGrid>
              </StackPanel>
              <StackPanel VerticalAlignment="Center" Margin="0,0,0,12">
                <TextBlock x:Name="DashAuto" Text="Not armed." FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="When a Steam or browser download slows below your limit, Steam Multitool can shut down, sleep or just notify you."
                           Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- ===================== DOWNLOADS ===================== -->
      <DockPanel x:Name="PageDownloads" Visibility="Collapsed">
        <Border x:Name="CountdownCard" DockPanel.Dock="Top" Margin="0,0,0,14" Background="#2E2614" BorderBrush="#4A3B17" BorderThickness="1"
                CornerRadius="14" Padding="18,12" Visibility="Collapsed">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource DangerButton}" Margin="0" Click="CancelCountdown_Click"/>
            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource Amber}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock x:Name="CountdownLabel" FontWeight="SemiBold" Foreground="{DynamicResource Amber}" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap"/>
          </DockPanel>
        </Border>

        <!-- Download doctor: why is Steam slow, and what still helps. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="20,14" Margin="0,0,0,14">
          <StackPanel>
            <DockPanel>
              <Button x:Name="DoctorButton" DockPanel.Dock="Right" Content="Check my downloads" Style="{StaticResource SmallPrimary}" VerticalAlignment="Center" Click="Doctor_Click"/>
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="DOWNLOAD DOCTOR" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                <TextBlock x:Name="DoctorVerdict" Text="Slow Steam downloads? Tests Steam's servers near you and your own line, then tells you which one is the limit. About 15 seconds."
                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
              </StackPanel>
            </DockPanel>
            <StackPanel x:Name="DoctorResults" Visibility="Collapsed" Margin="0,12,0,0">
              <WrapPanel x:Name="DoctorServers"/>
              <TextBlock x:Name="DoctorFixes" Foreground="{DynamicResource Text}" TextWrapping="Wrap" Margin="0,8,0,10"/>
              <!-- Windows settings that quietly cap speed: TCP auto-tuning and Wi-Fi power saving, each with a fix. -->
              <WrapPanel x:Name="DoctorChecks" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="Clear Steam's download cache" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="DoctorFlush_Click"
                        ToolTip="Asks Steam to clear its download cache and pick its servers again (steam://flushconfig). Steam restarts; you may need to log in again."/>
                <Button Content="Combine connections" Style="{StaticResource SmallButton}" Tag="bond" Click="HomeGo_Click"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource HeroCard}" Padding="22,16" Margin="0,14,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="AUTO ACTION" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
              <TextBlock x:Name="ActionPreview" Text="Choose an app and a speed floor. After a real download, staying under that speed starts the countdown." TextWrapping="Wrap" Foreground="{DynamicResource Text}" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="240">
              <TextBlock x:Name="ArmHint" Text="Not watching" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              <TextBlock Text="Arm once a download is running." Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
            <Button Grid.Column="4" x:Name="ArmButton" Content="Arm" Style="{StaticResource WideSafe}" Click="Arm_Click"/>
          </Grid>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.6*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource CardBorder}" Padding="20,18,12,10">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,8,12">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Background="{DynamicResource Raised}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock x:Name="DlState" Text="idle" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold"/>
                  </Border>
                  <TextBlock x:Name="DlHeadline" Text="No downloads" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                </DockPanel>
                <ProgressBar x:Name="DlBar" Margin="0,14,0,16" Maximum="1" Height="8"/>
                <UniformGrid Columns="4">
                  <StackPanel>
                    <TextBlock Text="Speed" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TileSpeed" Text="0 KB/s" Style="{StaticResource StatValue}" FontSize="18"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Left" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TileRemaining" Text="--" Style="{StaticResource StatValue}" FontSize="18"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Time left" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TileEta" Text="--" Style="{StaticResource StatValue}" FontSize="18"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Items" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TileJobs" Text="0" Style="{StaticResource StatValue}" FontSize="18"/>
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
              <Grid>
                <DataGrid x:Name="JobsGrid">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="GAME" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                    <DataGridTemplateColumn Header="PROGRESS" Width="130">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <DockPanel VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Width="40" TextAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12"/>
                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="1" Height="4" Margin="0,0,8,0"/>
                          </DockPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="LEFT" Binding="{Binding RemainingText}" Width="90"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="JobsEmpty" Text="Nothing in the Steam download queue." Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,4,0">
                <TextBlock Text="WHEN IT FINISHES" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Watch" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="WatchBox" Margin="0,0,0,12"/>
                <TextBlock Text="Finished when speed is under" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="FloorBox" Margin="0,0,0,12"/>
                <TextBlock Text="For at least" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="GraceBox" Margin="0,0,0,12"/>
                <TextBlock Text="Then" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ActionBox" Margin="0,0,0,12"/>
                <TextBlock Text="Warning countdown" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CountdownBox" Margin="0,0,0,8"/>
                <DockPanel Style="{StaticResource Row}">
                  <ToggleButton x:Name="QueuedBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="WatchSettings_Changed" Unchecked="WatchSettings_Changed"/>
                  <TextBlock Text="Count queued Steam items" Style="{StaticResource OptionText}"/>
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                  <ToggleButton x:Name="SeenBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="WatchSettings_Changed" Unchecked="WatchSettings_Changed"/>
                  <TextBlock Text="Wait for a fast download first" Style="{StaticResource OptionText}"/>
                </DockPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </DockPanel>

      <!-- ===================== LIBRARY ===================== -->
      <DockPanel x:Name="PageLibrary" Visibility="Collapsed">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
            <Button Content="Rescan" Style="{StaticResource GhostButton}" Click="Rescan_Click"/>
            <Button Content="Back up config" Style="{StaticResource GhostButton}" Click="Backup_Click" ToolTip="Zip Steam config and userdata to Documents\SteamStopperBackups"/>
            <Button Content="Clear caches" Style="{StaticResource GhostButton}" Margin="0" Click="ClearAll_Click" ToolTip="Empty Steam downloading, temp, HTML cache, logs and dumps"/>
          </StackPanel>
          <Grid>
            <TextBox x:Name="SearchBox" Padding="38,8,12,8" TextChanged="Search_Changed"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False"/>
            <TextBlock x:Name="SearchHint" Text="Search games or app IDs" IsHitTestVisible="False" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="40,0"/>
          </Grid>
        </DockPanel>
        <Border Style="{StaticResource CardBorder}" Padding="20,18,12,10">
          <DockPanel>
            <TextBlock x:Name="LibSummary" DockPanel.Dock="Top" Text="Scanning…" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>
            <DataGrid x:Name="GamesGrid" MouseDoubleClick="Games_DoubleClick" ToolTip="Double-click a game to open its folder">
              <DataGrid.Columns>
                <DataGridTextColumn Header="GAME" Binding="{Binding Name}" Width="*"/>
                <DataGridTemplateColumn Header="SHARE" Width="160">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="1" Height="4" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="100"/>
                <DataGridTextColumn Header="APP ID" Binding="{Binding AppId}" Width="90">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </DockPanel>

      <!-- ===================== DNS ===================== -->
      <Grid x:Name="PageDns" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.9*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource HeroCard}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
              <TextBlock Text="CURRENT DNS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
              <TextBlock x:Name="DnsHeadline" Text="—" Style="{StaticResource Hero}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="DnsHint" Text="Pick an adapter and a DNS, then apply or jump to the fastest." Foreground="{DynamicResource Muted}" Margin="0,4,0,18" TextWrapping="Wrap"/>
              <TextBlock Text="Adapter" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="DnsAdapterBox" Margin="0,0,0,14" SelectionChanged="DnsAdapter_Changed"/>
              <TextBlock Text="Primary and secondary server" Style="{StaticResource FieldLabel}"/>
              <UniformGrid Columns="2" Margin="0,0,0,18">
                <TextBox x:Name="DnsPrimaryBox" Margin="0,0,5,0" ToolTip="Primary DNS (IPv4)"/>
                <TextBox x:Name="DnsSecondaryBox" Margin="5,0,0,0" ToolTip="Secondary DNS (IPv4, optional)"/>
              </UniformGrid>
              <Button x:Name="DnsApplyButton" Content="Apply DNS" Style="{StaticResource WideSafe}" Click="DnsApply_Click"/>
              <UniformGrid Columns="2" Margin="0,8,0,0">
                <Button Content="Jump to fastest" Style="{StaticResource WideButton}" Margin="0,0,4,0" Click="DnsFastest_Click"/>
                <Button Content="Restore automatic" Style="{StaticResource WideButton}" Margin="4,0,0,0" Click="DnsRestore_Click"/>
              </UniformGrid>
              <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Left" Content="Flush DNS cache" Style="{StaticResource LinkButton}" Click="DnsFlush_Click"/>
                <TextBlock x:Name="DnsBusy" Text="" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20,18,12,10">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,8,10">
              <Button DockPanel.Dock="Right" Content="Ping all" Style="{StaticResource SmallButton}" Margin="0" Click="DnsPing_Click"/>
              <StackPanel>
                <TextBlock Text="PROVIDERS" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                <TextBlock Text="Double-click a provider to apply it." Foreground="{DynamicResource Faint}" FontSize="11"/>
              </StackPanel>
            </DockPanel>
            <DataGrid x:Name="DnsGrid" MouseDoubleClick="DnsGrid_DoubleClick" SelectionChanged="DnsGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="PROVIDER" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="SERVERS" Binding="{Binding Servers}" Width="1.3*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PING" Binding="{Binding PingText}" Width="70"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ===================== BOND ===================== -->
      <Grid x:Name="PageBond" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.9*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource HeroCard}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
              <TextBlock Text="LINK BONDING" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
              <TextBlock x:Name="BondHeadline" Text="Off" Style="{StaticResource Hero}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="BondHint" Foreground="{DynamicResource Muted}" Margin="0,4,0,18" TextWrapping="Wrap"
                         Text="Plug in two internet connections, for example Ethernet plus your phone over USB tethering or Wi-Fi hotspot, tick both on the right, then start."/>
              <TextBlock Text="Local proxy port" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="BondPortBox" Margin="0,0,0,14" ToolTip="Steam talks to the bonder on 127.0.0.1 at this port"/>
              <DockPanel Style="{StaticResource Option}" Margin="0,0,0,18">
                <ToggleButton x:Name="BondRestartBox" DockPanel.Dock="Right" Style="{StaticResource Switch}"/>
                <TextBlock Style="{StaticResource OptionText}" Text="Restart Steam on start and stop so it picks up the change"/>
              </DockPanel>
              <DockPanel Style="{StaticResource Option}" Margin="0,-10,0,8"
                         ToolTip="Measures each link's real speed and gives faster links more connections. The weights still count on top.">
                <ToggleButton x:Name="BondAutoBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="BondOptions_Click"/>
                <TextBlock Style="{StaticResource OptionText}" Text="Balance by measured speed"/>
              </DockPanel>
              <DockPanel Style="{StaticResource Option}" Margin="0,0,0,18"
                         ToolTip="Games, emulators and Discord go out the one link with the lowest ping instead of being spread, so bonding never adds lag.">
                <ToggleButton x:Name="BondGamesBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="BondOptions_Click"/>
                <TextBlock Style="{StaticResource OptionText}" Text="Keep games and voice chat on the quickest link"/>
              </DockPanel>
              <Button x:Name="BondButton" Content="Start bonding" Style="{StaticResource WideSafe}" Click="BondToggle_Click"/>
              <TextBlock x:Name="BondBusy" Text="" Foreground="{DynamicResource AccentText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="HOW IT WORKS" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
              <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap"
                         Text="Steam downloads a game over many connections at once. Bonding runs a small proxy on this PC and sends each new connection out a different link, so the speeds add up. One single connection still uses one link, and Windows' proxy setting is restored when you stop or close the app. Faster links get more connections by their measured speed; a weight adds to that. Each link asks its own DNS, so it downloads from the server nearest to its provider. A link that stops answering is skipped within a few seconds and used again once it's back."/>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20,18,12,10">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,8,10">
              <Button DockPanel.Dock="Right" Content="Rescan" Style="{StaticResource SmallButton}" Margin="0" Click="BondRescan_Click"/>
              <StackPanel>
                <TextBlock Text="INTERNET CONNECTIONS" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                <TextBlock x:Name="BondTotal" Text="Adapters with their own gateway show up here." Foreground="{DynamicResource Faint}" FontSize="11"/>
              </StackPanel>
            </DockPanel>
            <DataGrid x:Name="BondGrid">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="40">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Margin="0" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="CONNECTION" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel VerticalAlignment="Center" ToolTip="{Binding Hint}">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="WEIGHT" Width="76">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox ItemsSource="{Binding WeightChoices}" SelectedItem="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,2" VerticalAlignment="Center" ToolTip="Share of connections: 2 gets twice as many as 1"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="CONNS" Binding="{Binding Active}" Width="62"/>
                <DataGridTextColumn Header="SPEED" Binding="{Binding SpeedText}" Width="90"/>
                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalText}" Width="80"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ===================== FETCH ===================== -->
      <Grid x:Name="PageFetch" Visibility="Collapsed" AllowDrop="True" Drop="Fetch_Drop">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.85*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="1.15*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource HeroCard}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
              <TextBlock Text="DOWNLOAD SPEED" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
              <TextBlock x:Name="FetchHeadline" Text="Idle" Style="{StaticResource Hero}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="FetchHint" Foreground="{DynamicResource Muted}" Margin="0,4,0,16" TextWrapping="Wrap"/>

              <Border Background="{DynamicResource Raised}" CornerRadius="12" Padding="14,12" Margin="0,0,0,16">
                <StackPanel>
                  <DockPanel>
                    <ToggleButton x:Name="FetchBondBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  Click="FetchBond_Click" ToolTip="Spread every file over the connections ticked below"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Use all my connections" FontWeight="SemiBold"/>
                      <TextBlock x:Name="FetchBondHint" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,2,10,0"/>
                    </StackPanel>
                  </DockPanel>
                  <ItemsControl x:Name="FetchLinks" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,4" ToolTip="{Binding Hint}">
                          <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" Margin="0,0,10,0" Click="FetchLink_Click"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedText}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Rescan connections" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Padding="8,4" MinHeight="0"
                          Margin="-8,6,0,0" FontSize="12" Click="FetchRescan_Click"/>
                </StackPanel>
              </Border>

              <TextBlock Text="Links, one per line" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="FetchUrlBox" Height="72" AcceptsReturn="True" TextWrapping="NoWrap"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
              <TextBlock Text="Save to" Style="{StaticResource FieldLabel}"/>
              <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Change" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="FetchFolder_Click"/>
                <Border Background="{DynamicResource Raised}" CornerRadius="10" Padding="12,8">
                  <TextBlock x:Name="FetchPath" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                </Border>
              </DockPanel>
              <UniformGrid Columns="2" Margin="0,0,0,16">
                <StackPanel Margin="0,0,4,0">
                  <TextBlock Text="Connections per file" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="FetchConnBox" ToolTip="Auto starts with 4 and adds more while the download keeps getting faster. More connections spread better over your links; some servers limit this."/>
                </StackPanel>
                <StackPanel Margin="4,0,0,0">
                  <TextBlock Text="Files at once" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="FetchAtOnceBox"/>
                </StackPanel>
              </UniformGrid>
              <TextBlock Text="Speed limit" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="FetchLimitBox" Margin="0,0,0,16" ToolTip="Cap all downloads together, so games and calls keep some bandwidth"/>
              <Button Content="Download" Style="{StaticResource WideSafe}" Click="FetchAdd_Click"/>
              <TextBlock x:Name="FetchBusy" Text="" Foreground="{DynamicResource AccentText}" Margin="0,10,0,0" TextWrapping="Wrap"/>

            </StackPanel>
          </ScrollViewer>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20,18,12,10">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,8,10">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Pause" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="FetchPause_Click"/>
                <Button Content="Resume" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="FetchResume_Click"
                        ToolTip="Resume the selected files, or all paused ones when nothing is selected"/>
                <Button Content="Remove" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="FetchRemove_Click"
                        ToolTip="Remove the selected files, or clear finished ones when nothing is selected"/>
                <Button Content="Open folder" Style="{StaticResource SmallButton}" Margin="0" Click="FetchOpen_Click"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FILES" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                <TextBlock x:Name="FetchSummary" Text="" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
            <!-- Bottom of the file list, so it stays in view while downloads run. -->
              <Border Background="{DynamicResource Raised}" CornerRadius="12" Padding="14,12" Margin="0,10,8,0" DockPanel.Dock="Bottom">
                <StackPanel>
                  <DockPanel>
                    <ToggleButton x:Name="FetchAfterBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="FetchAfter_Click"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="When all downloads finish" FontWeight="SemiBold"/>
                      <TextBlock x:Name="FetchAfterHint" Text="Off. Turns itself off again after it runs." Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,2,10,0"/>
                    </StackPanel>
                  </DockPanel>
                  <ComboBox x:Name="FetchAfterActionBox" Margin="0,10,0,0"/>
                  <!-- One minute to change your mind before the PC goes down. -->
                  <DockPanel x:Name="FetchAfterCountdown" Margin="0,10,0,0" Visibility="Collapsed">
                    <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SmallButton}" Click="FetchAfterCancel_Click"/>
                    <TextBlock x:Name="FetchAfterCountdownText" Foreground="{DynamicResource Amber}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </DockPanel>
                </StackPanel>
              </Border>
            <Grid>
              <DataGrid x:Name="FetchGrid" SelectionMode="Extended" RowHeight="48" MouseDoubleClick="FetchGrid_DoubleClick"
                        ToolTip="Double-click a finished file to open it, or a paused one to resume. Right-click for more.">
                <DataGrid.ContextMenu>
                  <ContextMenu Opened="FetchMenu_Opened">
                    <MenuItem Header="Open" Click="FetchMenuOpen_Click"/>
                    <MenuItem Header="Show in folder" Click="FetchOpen_Click"/>
                    <MenuItem Header="Copy link" Click="FetchCopyLink_Click"/>
                    <Separator/>
                    <MenuItem Header="Resume" Click="FetchResume_Click"/>
                    <MenuItem Header="Pause" Click="FetchPause_Click"/>
                    <MenuItem Header="Download next" Click="FetchTop_Click"/>
                    <MenuItem Header="Continue with a new link" Click="FetchRelink_Click"
                              ToolTip="For an expired or broken link: copy a fresh link to the same file (or paste it in the Links box), then click this. What's downloaded is kept."/>
                    <Separator/>
                    <MenuItem Header="Remove" Click="FetchRemove_Click"/>
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="FILE" Width="*" MinWidth="160">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding Hint}">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="PROGRESS" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <DockPanel VerticalAlignment="Center">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Width="38" TextAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12"/>
                          <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="1" Height="4" Margin="0,0,8,0"/>
                        </DockPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="SPEED" Binding="{Binding SpeedText}" Width="96"/>
                  <DataGridTextColumn Header="LEFT" Binding="{Binding EtaText}" Width="62"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="FetchEmpty" Text="Paste a link on the left to start." Foreground="{DynamicResource Faint}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ===================== ROUTES ===================== -->
      <!-- ===================== NETWORK ===================== -->
      <Grid x:Name="PageNetwork" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="14"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource HeroCard}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel Margin="0,0,28,0">
                <TextBlock Text="DOWNLOAD" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                <TextBlock x:Name="NetDown" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Green}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="UPLOAD" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                <TextBlock x:Name="NetUp" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
              </StackPanel>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock Text="WHAT USES YOUR INTERNET" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
              <TextBlock x:Name="NetHeadline" Text="Starting…" Style="{StaticResource Hero}" FontSize="30" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="NetHint" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="Live, per app, while this page is open. Block cuts an app off the internet with Windows Firewall until you unblock it."/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="20,16,12,10">
          <Grid>
            <DataGrid x:Name="NetGrid" RowHeight="46" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="APP" Width="*" MinWidth="200">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel VerticalAlignment="Center" ToolTip="{Binding Path}">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="DOWN" Binding="{Binding DownText}" Width="100"/>
                <DataGridTextColumn Header="UP" Binding="{Binding UpText}" Width="100"/>
                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalText}" Width="90"/>
                <DataGridTemplateColumn Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="{Binding ActionText}" Style="{StaticResource SmallButton}" Click="NetBlock_Click"
                              HorizontalAlignment="Right" Margin="0,0,8,0" IsEnabled="{Binding CanBlock}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="NetEmpty" Text="No app has used the internet since this page opened." Foreground="{DynamicResource Faint}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="PageRoutes" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.9*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource HeroCard}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
              <TextBlock Text="MAIN CONNECTION" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
              <TextBlock x:Name="MainHeadline" Text="Automatic" Style="{StaticResource Hero}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Foreground="{DynamicResource Muted}" Margin="0,4,0,18" TextWrapping="Wrap"
                         Text="Everything without its own route uses the main connection, including games like Valorant. Pick your steadiest link, usually Ethernet."/>
              <TextBlock Text="Connection" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="MainLinkBox" Margin="0,0,0,18" DisplayMemberPath="Name"/>
              <Button Content="Make main" Style="{StaticResource WideSafe}" Click="MainSet_Click"/>
              <Button Content="Restore automatic" Style="{StaticResource WideButton}" Margin="0,8,0,0" Click="MainRestore_Click"/>
              <TextBlock x:Name="RoutesBusy" Text="" Foreground="{DynamicResource AccentText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="HOW IT WORKS" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
              <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap"
                         Text="Steam Multitool never touches the game, so anti-cheat has nothing to see. An app sent to another link is restarted through a small proxy pinned to that link. Discord voice also gets a Windows route to Discord's voice servers. Closing Steam Multitool restarts routed apps on the main connection."/>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20,18,12,10">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,8,10">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Rescan" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="RoutesRescan_Click"/>
                <Button Content="Reset all" Style="{StaticResource SmallButton}" Margin="0" Click="RoutesReset_Click"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="APPS" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                <TextBlock Text="Pick a connection for an app, then press Apply. The app restarts." Foreground="{DynamicResource Faint}" FontSize="11"/>
              </StackPanel>
            </DockPanel>
            <DataGrid x:Name="RoutesGrid">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="APP" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="CONNECTION" Width="1.1*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox ItemsSource="{Binding LinkChoices}" SelectedItem="{Binding Link, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding Installed}" Margin="0,2" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="84">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="Apply" Style="{StaticResource SmallButton}" Margin="0,2" Tag="{Binding}"
                              IsEnabled="{Binding Installed}" Click="RouteApply_Click"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ===================== CLEAN ===================== -->
      <Grid x:Name="PageClean" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.9*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource HeroCard}">
          <StackPanel>
            <TextBlock Text="READY TO FREE" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
            <TextBlock x:Name="CleanHeadline" Text="—" Style="{StaticResource Hero}" FontSize="44"/>
            <TextBlock x:Name="CleanHint" Text="Clears temp files, Recycle Bin, caches and Steam leftovers. Locked files are skipped." Foreground="{DynamicResource Muted}" Margin="0,6,0,22" TextWrapping="Wrap"/>
            <Button Content="Clean selected" Style="{StaticResource WideSafe}" Click="CleanRun_Click"/>
            <Button Content="Scan again" Style="{StaticResource WideButton}" Margin="0,8,0,0" Click="CleanScan_Click"/>
            <TextBlock x:Name="CleanBusy" Text="" Foreground="{DynamicResource AccentText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <Border Background="{DynamicResource Raised}" CornerRadius="12" Padding="14,12" Margin="0,18,0,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentText}" Margin="0,2,10,0"/>
                <TextBlock Text="Only junk folders are touched. Games, saves and documents are never deleted." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20,18,12,10">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,8,10">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Select all" Style="{StaticResource LinkButton}" Click="CleanSelectAll_Click"/>
                <Button Content="Select none" Style="{StaticResource LinkButton}" Margin="0" Click="CleanSelectNone_Click"/>
              </StackPanel>
              <TextBlock Text="TARGETS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
            </DockPanel>
            <DataGrid x:Name="CleanGrid">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="40">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Margin="0" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="ITEM" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" ToolTip="{Binding Hint}" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="90"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ===================== ORGANIZE ===================== -->
      <Grid x:Name="PageOrganize" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.9*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource HeroCard}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
              <TextBlock Text="READY TO SORT" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
              <TextBlock x:Name="OrgHeadline" Text="—" Style="{StaticResource Hero}" FontSize="44"/>
              <TextBlock x:Name="OrgHint" Text="Scanning…" Foreground="{DynamicResource Muted}" Margin="0,6,0,18" TextWrapping="Wrap"/>
              <TextBlock Text="Folder" Style="{StaticResource FieldLabel}"/>
              <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Content="Change" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="OrgChange_Click"/>
                <Border Background="{DynamicResource Raised}" CornerRadius="10" Padding="12,8">
                  <TextBlock x:Name="OrgPath" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                </Border>
              </DockPanel>
              <Button x:Name="OrgRunButton" Content="Organize now" Style="{StaticResource WideSafe}" Click="OrgRun_Click"/>
              <UniformGrid Columns="2" Margin="0,8,0,0">
                <Button Content="Scan again" Style="{StaticResource WideButton}" Margin="0,0,4,0" Click="OrgScan_Click"/>
                <Button x:Name="OrgUndoButton" Content="Undo last" Style="{StaticResource WideButton}" Margin="4,0,0,0" Click="OrgUndo_Click"/>
              </UniformGrid>
              <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Left" Content="Open folder" Style="{StaticResource LinkButton}" Click="OrgOpen_Click"/>
                <TextBlock x:Name="OrgBusy" Text="" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
              <Border Background="{DynamicResource Raised}" CornerRadius="12" Padding="14,12" Margin="0,14,0,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentText}" Margin="0,2,10,0"/>
                  <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"
                             Text="Loose files go into Installers, Archives, Documents, Images, Videos, Audio, Code, Fonts, Torrents and Other. Existing folders, unfinished downloads and files changed in the last 2 minutes are left alone. Nothing is deleted, and Undo puts every file back."/>
                </DockPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20,18,12,10">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,8,10">
              <TextBlock x:Name="OrgSummary" DockPanel.Dock="Right" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
              <TextBlock Text="PLAN" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
            </DockPanel>
            <Grid>
              <DataGrid x:Name="OrgGrid">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="FILE" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Source}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="MOVES TO" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource Selected}" CornerRadius="8" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Category}" Foreground="{DynamicResource AccentText}" FontSize="12"/>
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="90"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="OrgEmpty" Text="Nothing to sort. This folder is tidy." Foreground="{DynamicResource Faint}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ===================== GAMES ===================== -->
      <Grid x:Name="PageGames" Visibility="Collapsed" AllowDrop="True" Drop="Games_Drop">
        <Grid.Resources>
          <Style x:Key="GameRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,5" Margin="0,1">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- Steam's green play button; Tag="Stop" turns it into the blue Stop button while the game runs. -->
          <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bd" CornerRadius="6" Padding="26,0">
                    <Border.Background>
                      <SolidColorBrush Color="#75B022"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path x:Name="Icon" Data="M0,0 L12,7 L0,14 Z" Fill="White" Margin="0,0,12,0" VerticalAlignment="Center"/>
                      <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background">
                        <Setter.Value>
                          <SolidColorBrush Color="#8ED629"/>
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                    <Trigger Property="Tag" Value="Get">
                      <Setter TargetName="Icon" Property="Data" Value="M5,0 H9 V7 H13 L7,13 L1,7 H5 Z"/>
                      <Setter TargetName="Bd" Property="Background">
                        <Setter.Value>
                          <SolidColorBrush Color="#1A9FFF"/>
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                    <Trigger Property="Tag" Value="Stop">
                      <Setter TargetName="Icon" Property="Data" Value="M0,0 H12 V12 H0 Z"/>
                      <Setter TargetName="Bd" Property="Background">
                        <Setter.Value>
                          <SolidColorBrush Color="#1A9FFF"/>
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                    <MultiTrigger>
                      <MultiTrigger.Conditions>
                        <Condition Property="Tag" Value="Stop"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                      </MultiTrigger.Conditions>
                      <Setter TargetName="Bd" Property="Background">
                        <Setter.Value>
                          <SolidColorBrush Color="#47B4FF"/>
                        </Setter.Value>
                      </Setter>
                    </MultiTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Raised}"/>
                      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="290"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: the catalog, grouped by console like Steam's library list. -->
        <Border Style="{StaticResource CardBorder}" Padding="12,14,8,12">
          <DockPanel>
            <!-- Label on its own line: the column is too narrow for it beside three buttons. -->
            <TextBlock DockPanel.Dock="Top" Text="LIBRARY" Style="{StaticResource SectionLabel}" Margin="4,0,4,8"/>
            <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,4,10">
              <Button Content="Add" Style="{StaticResource SmallPrimary}" Margin="0,0,4,0" Click="GamesAdd_Click" ToolTip="Add a folder with your game files"/>
              <Button Content="Rescan" Style="{StaticResource SmallButton}" Margin="2,0" Click="GamesRescan_Click" ToolTip="Look for new games in your folders"/>
              <Button Content="Steam" Style="{StaticResource SmallButton}" Margin="4,0,0,0" Click="GamesToSteam_Click"
                      ToolTip="Add these games to Steam as non-Steam games, with box art, so they start from your Steam library and Big Picture"/>
            </UniformGrid>
            <Button DockPanel.Dock="Bottom" Content="Find missing covers" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="8,6,0,0" Click="GamesFixCovers_Click"
                    ToolTip="Pick box art for every game that has none, one after another"/>
            <TextBlock x:Name="GamesCount" DockPanel.Dock="Bottom" Foreground="{DynamicResource Faint}" FontSize="11" Margin="8,8,0,0"/>
            <Grid DockPanel.Dock="Top" Margin="0,0,4,10">
              <TextBox x:Name="GameSearchBox" TextChanged="GameSearch_Changed"/>
              <TextBlock x:Name="GameSearchHint" Text="Search games" IsHitTestVisible="False" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="14,0"/>
            </Grid>
            <ListBox x:Name="GamesList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource GameRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="GamesList_SelectionChanged">
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Margin="8,12,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Faint}">
                        <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ItemCount, Mode=OneWay}"/>
                      </TextBlock>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListBox.GroupStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Grid Width="26" Height="26" Margin="0,0,10,0">
                      <Border CornerRadius="5" Background="{Binding Color, Converter={StaticResource HexBrush}}">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <Border CornerRadius="5">
                        <Border.Background>
                          <ImageBrush ImageSource="{Binding Cover, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                        </Border.Background>
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- Right: the selected game's page. -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
          <Grid>
            <StackPanel x:Name="GamesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
              <TextBlock Text="Your games, in one place" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center"/>
              <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,18"
                         Text="Add the folder where you keep your game files, or drop files and folders here. Each game opens in the right emulator from the Emulators tab."/>
              <Button Content="Add folder" Style="{StaticResource WideSafe}" Click="GamesAdd_Click"/>
            </StackPanel>

            <DockPanel x:Name="GameDetail" Visibility="Collapsed">
              <!-- Clipped in code to the card's rounded corners; ClipToBounds alone leaves square ones. -->
              <Grid DockPanel.Dock="Top" Height="290" SizeChanged="GameHero_SizeChanged">
                <Border Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                <!-- Darken the top a little, fade into the card colour at the bottom (whatever the theme). -->
                <Border Background="#33000000"/>
                <Border Background="{DynamicResource Card}">
                  <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="Transparent" Offset="0"/>
                      <GradientStop Color="Black" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.OpacityMask>
                </Border>
                <DockPanel Margin="30,24,30,22" VerticalAlignment="Bottom">
                  <Grid Width="150" Height="200" Margin="0,0,24,0">
                    <Border CornerRadius="8" Background="{Binding Color, Converter={StaticResource HexBrush}}">
                      <TextBlock Text="{Binding Tile.Name, FallbackValue=?}" Foreground="White" FontSize="26" FontWeight="Black" FontFamily="{StaticResource DisplayFont}"
                                 TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>
                    </Border>
                    <Border CornerRadius="8">
                      <Border.Background>
                        <ImageBrush ImageSource="{Binding Cover, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                      </Border.Background>
                    </Border>
                  </Grid>
                  <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding ConsoleName}" Foreground="#D0FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="34" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" TextWrapping="Wrap">
                      <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.5"/>
                      </TextBlock.Effect>
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </Grid>

              <!-- Play bar -->
              <Border DockPanel.Dock="Top" Background="#14FFFFFF" Margin="24,8,24,0" CornerRadius="10" Padding="16,14">
                <DockPanel>
                  <Button x:Name="GamePlayButton" Style="{StaticResource PlayButton}" Content="PLAY" Click="GamePlay_Click" Margin="0,0,24,0"/>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,22,0">
                      <TextBlock Text="LAST PLAYED" Foreground="{DynamicResource Faint}" FontSize="11" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding LastPlayedText}" FontSize="14" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,22,0">
                      <TextBlock Text="PLAY TIME" Foreground="{DynamicResource Faint}" FontSize="11" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding PlayTimeText}" FontSize="14" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="GameEmuPanel">
                      <TextBlock Text="EMULATOR" Foreground="{DynamicResource Faint}" FontSize="11" FontWeight="SemiBold"/>
                      <ComboBox x:Name="GameEmuBox" MinWidth="130" Margin="0,3,0,0" SelectionChanged="GameEmu_Changed"/>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
              </Border>

              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,20,30,20">
                  <TextBlock x:Name="GameHint" Foreground="{DynamicResource AccentText}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                  <UniformGrid Columns="2" Margin="0,0,0,16">
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="Console" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="GameConsoleBox" SelectionChanged="GameConsole_Changed" ToolTip="Fix this if the game was put under the wrong console"/>
                    </StackPanel>
                    <StackPanel Margin="12,0,0,0">
                      <TextBlock Text="Size" Style="{StaticResource FieldLabel}"/>
                      <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                    </StackPanel>
                  </UniformGrid>
                  <!-- RetroAchievements progress, filled in by code when connected in Settings. -->
                  <StackPanel x:Name="GameCheevos" Margin="0,0,0,18" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,6">
                      <Button x:Name="GameCheevosLink" DockPanel.Dock="Right" Content="Open on RetroAchievements" Style="{StaticResource LinkButton}"
                              Padding="6,2" MinHeight="0" FontSize="12" Click="GameCheevosLink_Click"/>
                      <TextBlock Text="ACHIEVEMENTS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
                    </DockPanel>
                    <TextBlock x:Name="GameCheevosText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="GameCheevosBar" Height="4" Maximum="1" Margin="0,8,0,10"/>
                    <ItemsControl x:Name="GameCheevosList">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Width="44" Height="44" CornerRadius="6" Margin="0,0,6,6" ToolTip="{Binding Tip}" Background="{DynamicResource Raised}">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Earned}" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <Image Source="{Binding BadgeUrl}" Stretch="UniformToFill"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <TextBlock Text="File" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding Path}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                  <WrapPanel>
                    <Button Content="Open file location" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Click="GameOpenFolder_Click"/>
                    <Button Content="Rename" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Click="GameRename_Click"/>
                    <Button Content="Change cover" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Click="GameCover_Click"
                            ToolTip="Search box art for this game and pick one, or use an image file."/>
                    <Button Content="Back up saves" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Click="GameSaves_Click"
                            ToolTip="Zip the saves of this game's emulator. Restore is in Settings."/>
                    <Button Content="Remove from library" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Click="GameRemove_Click"
                            ToolTip="Takes it off this list. The game file stays on disk."/>
                  </WrapPanel>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- ===================== APPS ===================== -->
      <DockPanel x:Name="PageApps" Visibility="Collapsed">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="AppRefresh_Click"/>
          <Button DockPanel.Dock="Right" Content="Find leftovers" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="AppLeftovers_Click"
                  ToolTip="Look for folders left behind by apps that are no longer installed"/>
          <Grid>
            <TextBox x:Name="AppSearchBox" Padding="38,8,12,8" TextChanged="AppSearch_Changed"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False"/>
            <TextBlock x:Name="AppSearchHint" Text="Search apps" IsHitTestVisible="False" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="40,0"/>
          </Grid>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
          <Border x:Name="AppCatBorder" DockPanel.Dock="Left" Background="{DynamicResource Raised}" CornerRadius="12" Padding="3">
            <StackPanel Orientation="Horizontal" x:Name="AppCatBar"/>
          </Border>
          <!-- Emulators: consoles, or PC ports (recomps), which aren't a console. -->
          <Border x:Name="EmuTabsBorder" DockPanel.Dock="Left" Background="{DynamicResource Raised}" CornerRadius="12" Padding="3" Margin="0,0,14,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="EmuTabConsoles" Content="Consoles" GroupName="EmuTab" Style="{StaticResource Segment}" IsChecked="True" Click="EmuTab_Click"/>
              <RadioButton x:Name="EmuTabPorts" Content="PC ports" GroupName="EmuTab" Style="{StaticResource Segment}" Click="EmuTab_Click"
                           ToolTip="Native PC versions of games, rebuilt from your own copy of the game"/>
            </StackPanel>
          </Border>
          <Button x:Name="EmuBackButton" DockPanel.Dock="Left" Content="&#x2190;  All consoles" Style="{StaticResource GhostButton}"
                  Margin="0,0,14,0" Click="EmuBack_Click" Visibility="Collapsed"/>
          <TextBlock x:Name="EmuTitle" DockPanel.Dock="Left" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center"/>
          <StackPanel x:Name="EmuAutoPanel" DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed"
                      ToolTip="When a new build of an installed emulator comes out, install it in the background while the emulator is closed">
            <Button x:Name="EmuCheckButton" Content="Check for updates" Style="{StaticResource SmallButton}" Margin="0,0,16,0" Click="EmuCheck_Click"
                    ToolTip="Look for new builds of your installed emulators and ports now"/>
            <TextBlock Text="PGO builds" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                       ToolTip="Download the PGO (profile-guided optimisation) build when an emulator offers one, such as Eglantine. Usually faster; turn off for the standard build."/>
            <ToggleButton x:Name="EmuPgoBox" Style="{StaticResource Switch}" Click="EmuPgo_Click" Margin="0,0,16,0"/>
            <TextBlock Text="Auto-update" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ToggleButton x:Name="EmuAutoBox" Style="{StaticResource Switch}" Click="EmuAuto_Click"/>
          </StackPanel>
          <TextBlock x:Name="AppCount" DockPanel.Dock="Right" Text="" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock x:Name="AppBusy" Text="" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Grid>
        <ScrollViewer x:Name="ConsoleView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <ItemsControl x:Name="ConsoleGrid" Margin="0,6,4,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="5" VerticalAlignment="Top"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Click="ConsoleTile_Click" Cursor="Hand" Margin="0,0,12,12" Height="118" ToolTip="{Binding Maker}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Grid x:Name="Lift">
                      <Grid.RenderTransform>
                        <TranslateTransform/>
                      </Grid.RenderTransform>
                      <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                        <Grid.RenderTransform>
                          <ScaleTransform/>
                        </Grid.RenderTransform>
                        <Border CornerRadius="16" Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                        <Border x:Name="Ring" CornerRadius="16" BorderBrush="#40FFFFFF" BorderThickness="1"/>
                        <DockPanel Margin="16,14">
                          <TextBlock DockPanel.Dock="Bottom" Text="{Binding CountText}" Foreground="#D8FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                          <TextBlock DockPanel.Dock="Bottom" Text="{Binding Maker}" Foreground="#B0FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                          <Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" StretchDirection="DownOnly" MaxHeight="40">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Black">
                            </TextBlock>
                          </Viewbox>
                        </DockPanel>
                      </Grid>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-5" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                      </DoubleAnimation>
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                      </DoubleAnimation>
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.ExitActions>
                          <Setter TargetName="Ring" Property="BorderBrush" Value="#CCFFFFFF"/>
                          <Setter TargetName="Ring" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="Root" Property="RenderTransform">
                            <Setter.Value>
                              <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <ScrollViewer x:Name="AppsView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="AppsList" Margin="0,0,4,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4" VerticalAlignment="Top"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource AppCard}" ToolTip="{Binding Blurb}">
                  <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                      <Grid Width="44" Height="44" Margin="0,0,12,0">
                        <Border CornerRadius="12" Background="{Binding Color, Converter={StaticResource HexBrush}}">
                          <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="12" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IconUri}" Value="{x:Null}">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Image Source="{Binding IconUri}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                      </Grid>
                      <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom">
                      <Button DockPanel.Dock="Right" Click="AppCardAction_Click" Content="{Binding ActionLabel}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource SmallPrimary}">
                            <Setter Property="Margin" Value="0"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ActionLabel}" Value="Uninstall">
                                <Setter Property="Background" Value="{DynamicResource Raised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <Button DockPanel.Dock="Right" Click="AppCardRemove_Click" Content="{Binding SecondaryLabel}" Margin="0,0,6,0" ToolTip="Update, uninstall or delete this emulator">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding CanRemove}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                          <Ellipse.Style>
                            <Style TargetType="Ellipse">
                              <Setter Property="Fill" Value="{DynamicResource Faint}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Installed}" Value="True">
                                  <Setter Property="Fill" Value="{DynamicResource Green}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding State}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                      </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Blurb}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>

  <!-- Start-up animation: the gear turns into place and the play button pops in, then it all fades away. -->
  <Grid x:Name="IntroOverlay" Background="{DynamicResource Bg}" IsHitTestVisible="False">
    <Grid Width="120" Height="120">
      <Image x:Name="IntroTile" Source="Assets/intro-tile.png" RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform><ScaleTransform/></Image.RenderTransform>
      </Image>
      <Image x:Name="IntroGear" Source="Assets/intro-gear.png" RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform><RotateTransform/></Image.RenderTransform>
      </Image>
      <Image x:Name="IntroPlay" Source="Assets/intro-play.png" RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform><ScaleTransform/></Image.RenderTransform>
      </Image>
    </Grid>
  </Grid>
  </Grid>
</Window>
