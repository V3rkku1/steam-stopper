<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>SteamStopper</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">2.1.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\dist\app\</PublishDir>
    <DefineConstants>$(DefineConstants);Version=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <BindPath Include="$(PublishDir)" BindName="Publish" />
  </ItemGroup>
</Project>
